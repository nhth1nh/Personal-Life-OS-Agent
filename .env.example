# === PostgreSQL ===
POSTGRES_DB=ploa
POSTGRES_USER=ploa
POSTGRES_PASSWORD=changeme
DATABASE_URL=jdbc:postgresql://postgres:5432/ploa

# === API Security ===
API_SECRET_KEY=changeme-strong-secret

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_BOT_USERNAME=YourBotUsername
# Comma-separated list of allowed Telegram user IDs (whitelist)
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# === AI - Cloud (Gemini) ===
GOOGLE_AI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# === AI - Local (Ollama) ===
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=llama3.2

# === Garmin Puller ===
GARMIN_EMAIL=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password
# Time to pull (HH:MM, local time)
GARMIN_PULL_TIME=06:30
BACKEND_HEALTH_SYNC_URL=http://backend:8080/api/v1/health/sync
